# Environment variables & secrets
.env
.env.*
*.env

# Virtual environments
.venv/
venv/
ENV/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Media & Heavy Binary Assets (Never commit raw video or audio)
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv
*.m4a
*.mp3
*.wav
*.aac
*.flac
*.ogg
*.opus

# Project storage directories (Preserve folder structure, ignore contents)
data/videos/*
!data/videos/.gitkeep
data/audio/*
!data/audio/.gitkeep
data/staging/
data/cache/
data/reels/

# Database files & local sessions
*.db
*.sqlite
*.sqlite3
*.ses
data/app.db
data/*.db
data/*.sqlite

# Exports, scratch & temporary files
export/
*.tmp
reel_download_*

# System files
.DS_Store
Thumbs.db